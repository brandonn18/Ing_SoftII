# ─── Servidor ────────────────────────────────────────────────────────────────
# Puerto donde escucha el backend (default: 3001)
PORT=3001

# Entorno: development | test | production
NODE_ENV=development

# ─── Base de datos PostgreSQL ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432

# Nombre de la base de datos principal
DB_NAME=tickets_ti

# Nombre de la base de datos usada en tests (se destruye y recrea en cada run)
DB_NAME_TEST=tickets_ti_test

DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Activar SSL para la conexión (requerido en Heroku/Railway/RDS): true | false
DB_SSL=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Clave secreta para firmar tokens. DEBE ser larga y aleatoria en producción.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Tiempo de expiración del token. Formato: 8h | 1d | 30m
JWT_EXPIRES_IN=8h

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Host SMTP: smtp.gmail.com | smtp.office365.com | etc.
EMAIL_HOST=smtp.gmail.com

# Puerto SMTP: 587 (STARTTLS) | 465 (SSL)
EMAIL_PORT=587

# Cuenta de correo desde la que se envían los emails del sistema
EMAIL_USER=notificaciones@tuempresa.com

# Contraseña o App Password de Gmail
EMAIL_PASS=your_email_app_password

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL del frontend. En producción: https://tudominio.com
FRONTEND_URL=http://localhost:3000
