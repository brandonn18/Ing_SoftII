# ─── PRODUCCIÓN — copiar a .env en el servidor y completar valores reales ─────

PORT=3001
NODE_ENV=production

# Base de datos (usar variables del proveedor cloud: Railway, Supabase, RDS, etc.)
DB_HOST=your_production_db_host
DB_PORT=5432
DB_NAME=tickets_ti_prod
DB_USER=tickets_user
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_SSL=true

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_real_secret_at_least_64_chars
JWT_EXPIRES_IN=8h

# Email SMTP de producción
EMAIL_HOST=smtp.tuservidor.com
EMAIL_PORT=587
EMAIL_USER=soporte@tuempresa.com
EMAIL_PASS=CHANGE_ME_email_password

# URL pública del frontend en producción
FRONTEND_URL=https://tickets.tuempresa.com
